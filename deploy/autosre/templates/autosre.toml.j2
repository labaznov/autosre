# Настройки агента. Раскладывается ролью Ansible, лежит в git инфраструктуры.
# Секретов здесь нет: они приходят из окружения (ADR-0025).

# Настройки агента диагностики.
#
# Здесь всё, что описывает поведение. Ключи доступа сюда не попадают никогда —
# они приходят из окружения (ADR-0025):
#
#   AUTOSRE_MODEL_KEY       ключ LiteLLM
#   AUTOSRE_SESSION_KEY     ключ подписи сессий веб-морды
#   AUTOSRE_LOGS_PASSWORD   пароль VictoriaLogs, если он нужен

bind = "0.0.0.0:8096"
database = "/opt/data/autosre/autosre.db"

[logs]
url = "{{ autosre_logs_url }}"
username = "{{ autosre_logs_username }}"
timeout = "60s"
error_pattern = "i(error*) OR i(exception*) OR i(panic*) OR i(fatal*) OR i(traceback*)"
# Собственные потоки агента. Без них он находит сам себя и разбирает сам себя.
self_streams = ['{{ autosre_self_streams }}']

[metrics]
url = "{{ autosre_metrics_url }}"
timeout = "30s"
# Правила отбора наблюдаемых серий: универсальный набор признаков здоровья.
select = [
    "process_resident_memory_bytes",
    "node_filesystem_avail_bytes",
    "go_goroutines",
    "process_start_time_seconds",
    "http_request_duration_seconds_count",
    "go_goroutines",
]

[model]
url = "{{ autosre_model_url }}"
name = "{{ autosre_model_name }}"
timeout = "180s"
max_tokens = 900
temperature = 0.2

# Горизонты. Ширина окна и период оценки — разные вещи: задержку обнаружения
# задаёт период, а ширина отвечает за чувствительность (ADR-0014).

[[horizon]]
name = "15m"
width = "15m"
period = "1m"
minimum = 20
score = 3.5
ratio = 2.0

[[horizon]]
name = "1h"
width = "1h"
period = "5m"
minimum = 40
score = 3.5
ratio = 1.5

[[horizon]]
name = "24h"
width = "24h"
period = "1h"
minimum = 200
score = 3.0
ratio = 1.5

# Пятиминутный горизонт нужен там, где важны короткие всплески и хватает
# объёма для устойчивой статистики. На малых объёмах он шумит.
[[horizon]]
name = "5m"
width = "5m"
period = "1m"
enabled = false
minimum = 15
score = 4.0
ratio = 3.0

{% for account in autosre_accounts %}
[[account]]
login = "{{ account.login }}"
password = "{{ account.password }}"
{% endfor %}

[incidents]
# Из каких меток селектора берётся имя сервиса, в порядке предпочтения.
service_labels = ["service", "container", "job", "app", "__series__"]
silence = "30m"
link = "5m"

[collector]
# Насколько глубоко закрывать дыры в ряду при старте и сколько минут просить
# у источника за один запрос. Меньше, чем нужно самому короткому горизонту на
# базовую линию, агент не возьмёт: иначе после чистого старта он слеп часами.
backfill = "2h"
chunk = "1h"

[digging]
# Каталог скиллов в рабочей копии репозитория знаний.
skills = "/opt/data/autosre/knowledge/skills"
parallel = 4
# Сколько раз модель может попросить добрать данные.
steps = 3
wider = "1h"
# Сколько инцидент ждёт разбора, прежде чем дойти до дежурного без вывода.
patience = "15m"
# Как часто очередь оглядывается и сколько заявка ждёт ответа дежурного.
tick = "1m"
answer = "{{ autosre_answer }}"

[knowledge]
# Рабочая копия репозитория знаний: заметки правят люди, агент только читает.
notes = "/opt/data/autosre/knowledge/notes"
# Куда агент пишет черновики заметок и с какой уверенности берётся за них.
drafts = "/opt/data/autosre/knowledge/drafts"
# Куда ложатся отчёты: их пишет агент, люди только читают.
reports = "/opt/data/autosre/knowledge/reports"
worth = 0.5
refresh = "5m"
# Сколько заметок уходит в досье расследования.
recall = 3

[corpus]
# Сбор живых данных: по записи на каждый заход в модель, для подбора порогов и
# дообучения ([ADR-0027](../../docs/adr/0027-live-corpus.md)). Выгрузка —
# `GET /api/corpus`, построчным JSON, за входом.
collect = {{ autosre_corpus | lower }}
# Отдавать ли сырые строки. По умолчанию адреса, идентификаторы и числа
# маскируются: корпус уезжает из контура.
raw = {{ autosre_corpus_raw | lower }}

[queue]
parallel = 4
patience = "15m"

[retention]
minute_buckets = "7d"
hour_buckets = "395d"
investigations = "90d"
incidents = "365d"