# Настройки агента. Раскладывается ролью Ansible, лежит в git инфраструктуры.
# Секретов здесь нет: они приходят из окружения (ADR-0025).

# Настройки агента диагностики.
#
# Здесь всё, что описывает поведение. Ключи доступа сюда не попадают никогда —
# они приходят из окружения (ADR-0025):
#
#   SREAGENT_MODEL_KEY       ключ LiteLLM
#   SREAGENT_SESSION_KEY     ключ подписи сессий веб-морды
#   SREAGENT_LOGS_PASSWORD   пароль VictoriaLogs, если он нужен

bind = "0.0.0.0:8096"
database = "/opt/data/sreagent/sre.db"

[logs]
url = "{{ sreagent_logs_url | default(victorialogs_url | default('http://192.0.2.12:9428')) }}"
username = "{{ sreagent_logs_username | default('admin') }}"
timeout = "60s"
error_pattern = "i(error*) OR i(exception*) OR i(panic*) OR i(fatal*) OR i(traceback*)"
# Собственные потоки агента. Без них он находит сам себя и разбирает сам себя.
self_streams = ['{{ sreagent_self_streams | default('{container="sreagent"}') }}']

[metrics]
url = "{{ sreagent_metrics_url | default(victoriametrics_url | default('http://192.0.2.11:8428')) }}"
timeout = "30s"
# Правила отбора наблюдаемых серий: универсальный набор признаков здоровья.
select = [
    "process_resident_memory_bytes",
    "node_filesystem_avail_bytes",
    "go_goroutines",
    "process_start_time_seconds",
    "http_request_duration_seconds_count",
    "go_goroutines",
]

[model]
url = "{{ sreagent_model_url | default('http://192.0.2.10:4000') }}"
name = "{{ sreagent_model_name | default('gemma-4-12B-it-qat-q4_0-gguf') }}"
timeout = "180s"
max_tokens = 900
temperature = 0.2

# Горизонты. Ширина окна и период оценки — разные вещи: задержку обнаружения
# задаёт период, а ширина отвечает за чувствительность (ADR-0014).

[[horizon]]
name = "15m"
width = "15m"
period = "1m"
minimum = 20
score = 3.5
ratio = 2.0

[[horizon]]
name = "1h"
width = "1h"
period = "5m"
minimum = 40
score = 3.5
ratio = 1.5

[[horizon]]
name = "24h"
width = "24h"
period = "1h"
minimum = 200
score = 3.0
ratio = 1.5

# Пятиминутный горизонт нужен там, где важны короткие всплески и хватает
# объёма для устойчивой статистики. На малых объёмах он шумит.
[[horizon]]
name = "5m"
width = "5m"
period = "1m"
enabled = false
minimum = 15
score = 4.0
ratio = 3.0

{% for account in sreagent_accounts %}
[[account]]
login = "{{ account.login }}"
password = "{{ account.password }}"
{% endfor %}

[incidents]
# Из каких меток селектора берётся имя сервиса, в порядке предпочтения.
service_labels = ["service", "container", "job", "app", "__series__"]
silence = "30m"
link = "5m"

[collector]
# Насколько глубоко закрывать дыры в ряду при старте и сколько минут просить
# у источника за один запрос.
backfill = "2h"
chunk = "1h"

[digging]
# Каталог скиллов в рабочей копии репозитория знаний.
skills = "/opt/data/sreagent/knowledge/skills"
parallel = 4
# Сколько раз модель может попросить добрать данные.
steps = 3
wider = "1h"
# Сколько инцидент ждёт разбора, прежде чем дойти до дежурного без вывода.
patience = "15m"

[queue]
parallel = 4
patience = "15m"

[retention]
minute_buckets = "7d"
hour_buckets = "395d"
investigations = "90d"
incidents = "365d"