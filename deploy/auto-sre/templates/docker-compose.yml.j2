services:
  sreagent:
    build:
      context: /opt/docker/sreagent/src
    image: sreagent:{{ sreagent_version | default('latest') }}
    container_name: sreagent
    restart: unless-stopped
    env_file: /opt/docker/sreagent/.env
    command: ["/etc/sreagent/sreagent.toml"]
    ports:
      - "{{ sreagent_port | default(8096) }}:8096"
    volumes:
      - /opt/docker/sreagent/sreagent.toml:/etc/sreagent/sreagent.toml:ro
      - /opt/data/sreagent:/opt/data/sreagent
    logging:
      driver: json-file
      options:
        max-size: "20m"
        max-file: "5"
