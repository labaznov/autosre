# Секреты агента. Только они, и ничего кроме них (docs/adr/0025-config-file-and-secrets.md).
# Файл читает systemd (EnvironmentFile), права 0600, владелец root.

# Ключ к OpenAI-совместимому API модели. Обязателен.
AUTOSRE_MODEL_KEY=

# Ключ подписи сессий веб-морды: любая длинная случайная строка. Обязателен.
# Сменить ключ — значит разлогинить всех.
AUTOSRE_SESSION_KEY=

# Пароль VictoriaLogs, если логи за basic-аутентификацией. Иначе пусто.
AUTOSRE_LOGS_PASSWORD=

# Уровень журнала: error, warn, info, debug.
AUTOSRE_LOG=info
